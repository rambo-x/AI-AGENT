"""
TripleSide AI Telegram Response Formatter

Convert AI reports into human readable Telegram messages.

Supports:
- reasoning reports
- decision reports
- incident memory status
"""


class ResponseFormatter:



    def format(
        self,
        reasoning,
        decision,
        memory=None
    ):


        lines = []


        lines.append(
            "🧠 TripleSide AI Diagnostic"
        )


        lines.append(
            ""
        )



        diagnoses = reasoning.get(
            "diagnoses",
            []
        )


        decisions = decision.get(
            "decisions",
            []
        )



        if diagnoses:


            lines.append(
                "📌 Temuan:"
            )


            for item in diagnoses:


                problem = item.get(
                    "problem",
                    "-"
                )


                confidence = item.get(
                    "confidence",
                    0
                )


                lines.append(

                    f"• {problem} "
                    f"({int(confidence*100)}%)"

                )



        # -----------------------------
        # Incident Memory Status
        # -----------------------------

        if memory:


            resolved = []


            active = []


            for item in memory:


                for case in item.get(
                    "cases",
                    []
                ):


                    if case.get(
                        "status"
                    ) == "resolved":


                        resolved.append(
                            case
                        )

                    else:

                        active.append(
                            case
                        )



            if resolved:


                lines.append(
                    ""
                )


                lines.append(
                    "🧠 Memory Incident:"
                )


                for case in resolved:


                    lines.append(
                        "✅ "
                        +
                        case.get(
                            "problem",
                            "-"
                        )
                        +
                        " sudah resolved"
                    )


                    if case.get(
                        "resolution"
                    ):


                        lines.append(
                            "  "
                            +
                            case.get(
                                "resolution"
                            )
                        )



            if active:


                lines.append(
                    ""
                )


                lines.append(
                    "⚠️ Active Incident:"
                )


                for case in active:


                    lines.append(
                        "• "
                        +
                        case.get(
                            "problem",
                            "-"
                        )
                    )





        if decisions:


            lines.append(
                ""
            )


            lines.append(
                "🔍 Analisa:"
            )


            for item in decisions:


                root = item.get(
                    "root_cause"
                )


                if root:


                    lines.append(
                        f"• Penyebab: {root}"
                    )



                recommendations = item.get(
                    "recommendation",
                    []
                )


                for rec in recommendations:


                    lines.append(
                        f"  - {rec}"
                    )



        lines.append(
            ""
        )


        lines.append(
            "✅ Diagnostic selesai."
        )


        return "\n".join(lines)
